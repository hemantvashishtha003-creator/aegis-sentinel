# ==============================================================================
# AEGIS-SENTINEL: Production Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# SQLite Persistent Database Path
DB_PATH=/app/data/security_sentinel.sqlite

# 256-Bit Master Key for Evidence Vault Encryption (AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_ENCRYPTION_KEY=ae92f38d17b4c6e9821a4f5c9e2b8d7a1f4c6e8b2a3d5f7e9c1b3a5d7e9f1a3c

# HMAC Secret Key for Cryptographic Tamper-Proof Command Signatures
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HMAC_SECRET=sentinel-mdm-tamper-proof-hmac-secret-key-2026

# Retention limits (Days)
DEFAULT_RETENTION_DAYS=90

# Testing Flag: Allows full factory reset execution on isolated lab devices
ALLOW_SIMULATED_DESTRUCTIVE=true
